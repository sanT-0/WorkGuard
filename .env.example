# WorkGuard control-plane environment variables.
#
# These values are read from the process environment; the application does not
# load .env files. Set them in your shell, a service unit, or a secret manager.
# Never commit real secrets.

# --- Runtime mode -----------------------------------------------------------
# local | staging | production
APP_ENV=local

# dev | oidc
# `dev` is only accepted when APP_ENV=local and ALLOW_DEV_AUTH=1.
AUTH_MODE=dev
ALLOW_DEV_AUTH=1

# Legacy X-Device-Id agent authentication. Keep disabled; use bearer tokens.
ALLOW_INSECURE_DEVICE_HEADER=0

# --- Administrator OIDC (required when AUTH_MODE=oidc) ----------------------
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
# Optional explicit JWKS URL; defaults to $OIDC_ISSUER_URL/.well-known/jwks.json
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles

# --- Storage ----------------------------------------------------------------
WG_DB_PATH=control-api/workguard.db
WG_DEVICE_TOKEN_FILE=control-api/.dev-device-tokens.json

# --- Policy signing ---------------------------------------------------------
# Local development generates this key on first run (git-ignored). Non-local
# environments must provide a KMS/HSM-materialised Ed25519 private key here.
POLICY_SIGNING_KEY_PATH=control-api/.local/policy_signing_key.pem
POLICY_SIGNING_KEY_ID=wg-policy-local-v1
POLICY_ENVELOPE_TTL_SECONDS=3600
POLICY_CLOCK_SKEW_SECONDS=30

# --- Enrollment and device credentials --------------------------------------
ENROLLMENT_CODE_TTL_SECONDS=300
# Random deployment secrets. The development defaults are rejected when
# APP_ENV is not local.
ENROLLMENT_CODE_PEPPER=local-dev-enrollment-pepper-change-me
DEVICE_TOKEN_PEPPER=local-dev-device-pepper-change-me

# --- Fleet freshness --------------------------------------------------------
DEVICE_STALE_AFTER_SECONDS=1800
DEVICE_WARN_AFTER_SECONDS=600
STALE_SWEEP_INTERVAL_SECONDS=60

# --- Ingestion limits -------------------------------------------------------
MAX_EVENT_BATCH_SIZE=100
MAX_EVENT_PAYLOAD_BYTES=262144

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_ENABLED=1
PUBLIC_BASE_URL=http://127.0.0.1:8000

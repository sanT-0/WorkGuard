# Example variable names only. Use a secret manager for production secrets.
APP_ENV=local
APP_NAME=WorkGuard
API_BASE_PATH=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# Configure a real OIDC provider before enabling admin login.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# Database URL is secret in deployed environments; never commit a real value.
DATABASE_URL=postgresql://workguard_dev:change-me@localhost:5432/workguard_dev

# Use a secret manager/KMS integration for policy signing in production.
POLICY_SIGNING_KEY_ID=
# URL returning the JSON Web Key Set (RFC 7517) containing active and historical
# Ed25519 public keys used to verify policy signatures. Must be served over TLS.
POLICY_VERIFYING_KEY_SET_URL=

# Device/enrollment controls
# Single-use code lifetime (pilot default: 300s = 5m; max 600s) (F-011)
ENROLLMENT_CODE_TTL_SECONDS=300
AGENT_HEARTBEAT_INTERVAL_SECONDS=300
# Warning threshold before stale state (e.g., 2 missed heartbeats = 600s) (F-013)
DEVICE_WARN_AFTER_SECONDS=600
# Stale threshold marking offline/unverified state in control plane
DEVICE_STALE_AFTER_SECONDS=1800
MAX_EVENT_BATCH_SIZE=100
MAX_EVENT_PAYLOAD_BYTES=262144

# Configure these for production observability and tamper-evident audit logging (F-017).
LOG_LEVEL=INFO
# Immutable audit sink URL (e.g., S3 Object Lock compliance bucket, CloudWatch log group ARN, or SIEM ingest)
AUDIT_SINK_URL=

# Never put reusable agent secrets, policy private keys, OIDC client secrets,
# or production database passwords in this file.
